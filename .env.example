DATABASE_URL=postgres://postgres:YOURPASSWORD@localhost:5432/wallet   # URL-encode special characters: @ -> %40
PORT=3000
ADMIN_TOKEN=dev-admin-token
# Leave ANTHROPIC_API_KEY empty to use the built-in mock model (demo mode).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
WITHDRAWAL_FEE_PAISE=0
RECON_CRON=0 2 * * *
# Used only by `npm test` and the labs (needs permission to create databases):
TEST_ADMIN_URL=postgres://postgres:YOURPASSWORD@localhost:5432/postgres
