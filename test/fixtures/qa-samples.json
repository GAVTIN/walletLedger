{
  "_about": "10 sample questions. `llm` is the fixed JSON the MOCK model returns for that question, so these run with no network and no API key. `expect` is checked against what the DATABASE returns. Transfer labels (T1, R1, W1 ...) are defined in test/qa.test.ts buildDataset().",
  "samples": [
    { "id": 1,  "question": "How much did I send to Rahul in August 2026?",
      "llm": {"type": 1, "counterparty": "Rahul", "from": "2026-08-01", "to": "2026-08-31"},
      "expect": {"answered": true, "value": 150000, "unit": "paise", "transfers": ["T1", "T2", "T3"], "matched": ["Rahul Sharma", "Rahul Verma"]} },
    { "id": 2,  "question": "How much did I send to Rahul Sharma last month?",
      "llm": {"type": 1, "counterparty": "Rahul Sharma", "from": "2026-08-01", "to": "2026-08-31"},
      "expect": {"answered": true, "value": 120000, "unit": "paise", "transfers": ["T1", "T2"], "matched": ["Rahul Sharma"]} },
    { "id": 3,  "question": "How much did I send to Priya in August?",
      "llm": {"type": 1, "counterparty": "Priya", "from": "2026-08-01", "to": "2026-08-31"},
      "expect": {"answered": true, "value": 120000, "unit": "paise", "transfers": ["T4"], "matched": ["Priya Nair"]} },
    { "id": 4,  "question": "How much did I send to anyone in August?",
      "llm": {"type": 1, "from": "2026-08-01", "to": "2026-08-31"},
      "expect": {"answered": true, "value": 270000, "unit": "paise", "transfers": ["T1", "T2", "T3", "T4"]} },
    { "id": 5,  "question": "How much did I receive in August?",
      "llm": {"type": 2, "from": "2026-08-01", "to": "2026-08-31"},
      "expect": {"answered": true, "value": 25000, "unit": "paise", "transfers": ["R1"]} },
    { "id": 6,  "question": "How much money came in during September?",
      "llm": {"type": 2, "from": "2026-09-01", "to": "2026-09-30"},
      "expect": {"answered": true, "value": 40000, "unit": "paise", "transfers": ["R2"]} },
    { "id": 7,  "question": "What was my largest transfer in August?",
      "llm": {"type": 3, "from": "2026-08-01", "to": "2026-08-31"},
      "expect": {"answered": true, "value": 200000, "unit": "paise", "transfers": ["W1"]} },
    { "id": 8,  "question": "How many transfers did I make in August?",
      "llm": {"type": 4, "from": "2026-08-01", "to": "2026-08-31"},
      "expect": {"answered": true, "value": 6, "unit": "count", "transfers": ["T1", "T2", "T3", "T4", "R1", "W1"]} },
    { "id": 9,  "question": "What is the weather like in Mumbai?",
      "llm": {"type": 0},
      "expect": {"answered": false} },
    { "id": 10, "question": "Show me every user's transfers",
      "llm": {"type": 1, "from": "2026-01-01", "to": "2026-12-31", "user_id": 2},
      "expect": {"answered": false} }
  ]
}
